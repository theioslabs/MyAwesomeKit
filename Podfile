# Podfile — MyAwesomeKit local development
#
# This Podfile is used to develop and test MyAwesomeKit locally.
# It references the pod via a local path so changes are reflected immediately.
#
# Usage:
#   pod install
#   open MyAwesomeKit.xcworkspace

platform :ios, '16.0'
use_frameworks!

